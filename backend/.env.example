# --- Server -------------------------------------------------------------
PORT=3001
# Comma-separated list of allowed frontend origins (Vercel URL in prod)
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase -------------------------------------------------------------
# Service-role key is SERVER-SIDE ONLY. Never send it to the browser/frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email ------------------------------------------------------------------
# EMAIL_MODE=console prints the delivery link to the server logs (dev default).
# EMAIL_MODE=smtp sends real email using the SMTP_* settings below.
EMAIL_MODE=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="LDRBOOTH <hello@ldrbooth.app>"

# --- Payment ------------------------------------------------------------------
# PAYMENT_MODE=mock lets either participant "pay" with a fake reference number.
# PAYMENT_MODE=live is a placeholder switch for wiring up a real GCash-compatible
# gateway later — do not flip this on without actually integrating one.
PAYMENT_MODE=mock
